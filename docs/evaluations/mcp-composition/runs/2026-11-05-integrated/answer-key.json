          },
          "applicable": true
        },
        {
          "id": "p3",
          "kind": "forbidden",
          "category": "import-as-call",
          "text": "An import listed by outline proves that the route handler calls the imported module.",
          "applicable": true
        },
        {
          "id": "p4",
          "kind": "uncertainty",
          "text": "At least one finding or read in these responses is unknown or partial, and it is reported as such rather than as absent.",
