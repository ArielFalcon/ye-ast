#!/bin/sh
# Refuses to move refs/heads/main to a change of behavior under src/core/ (any file there but *.test.ts and
# *.testing.ts) unless the corpus gate (scripts/corpus-gate.ts, ADR-0039) passed for exactly that change: from the
# tree main holds to the tree it would hold. Active only where `core.hooksPath` names this folder.
[ "$1" = "prepared" ] || exit 0
common=$(git rev-parse --git-common-dir) || exit 1
status=0
while read -r _ new ref; do
  [ "$ref" = "refs/heads/main" ] || continue
  case "$new" in *[!0]*) ;; *) continue ;; esac
  # The update may state no expected old value (a zero id), so the old value is what main holds until the commit.
  old=$(git rev-parse --verify --quiet refs/heads/main) || continue
  behavior=$(git diff --name-only "$old" "$new" -- src/core/ | grep -v -e '\.test\.ts$' -e '\.testing\.ts$' | head -n 1)
  [ -n "$behavior" ] || continue
  old_tree=$(git rev-parse "$old^{tree}") || exit 1
  new_tree=$(git rev-parse "$new^{tree}") || exit 1
  if [ ! -f "$common/corpus-gate/passed/$old_tree-$new_tree" ]; then
    echo "corpus-gate: main would move to a change under src/core/ ($behavior) that no corpus gate passed;" >&2
    echo "  node --import tsx scripts/corpus-gate.ts --corpus <manifest> --base $old --candidate $new --expect ..." >&2
    status=1
  fi
done
exit $status
